# Redpanda (streaming compatible Kafka) + Redpanda Console — namespace redpanda.
#
#   Kafka (interne) : redpanda.redpanda.svc.cluster.local:9093  (PLAINTEXT, sans SASL)
#   Schema Registry : http://redpanda.redpanda.svc.cluster.local:8081
#   HTTP Proxy      : http://redpanda.redpanda.svc.cluster.local:8082
#   Console         : https://redpanda.{{ .Values.domain }}
#   rpk             : make rpk ARGS="cluster info"

# 3 brokers, un par nœud (anti-affinité stricte par défaut dans le chart).
statefulset:
  replicas: 3

resources:
  cpu:
    cores: 1
    # Labo : pas d'épinglage des cœurs, Redpanda partage le CPU avec le reste.
    overprovisioned: true
  memory:
    container:
      max: 2.5Gi

storage:
  persistentVolume:
    enabled: true
    size: 10Gi
    storageClass: {{ .Values.storageClass }}

# Labo : réseau interne au cluster, sans TLS ni SASL (à durcir pour un usage réel).
tls:
  enabled: false
auth:
  sasl:
    enabled: false
# Pas d'exposition NodePort ; accès depuis l'hôte via 'make rpk' ou port-forward.
external:
  enabled: false

# Le réglage AIO de l'hôte demande un conteneur privilégié : désactivé.
tuning:
  tune_aio_events: false

config:
  cluster:
    auto_create_topics_enabled: true
    default_topic_replications: 3
    # Rester en édition Community : ces deux réglages sont des fonctions Enterprise,
    # actives par défaut pendant l'essai de 30 jours. Actives sans licence après
    # l'essai, elles passent en mode restreint et bloquent les montées de version.
    partition_autobalancing_mode: node_add
    core_balancing_continuous: false

# Supervision : ServiceMonitor sur /public_metrics des brokers.
monitoring:
  enabled: true
  scrapeInterval: 30s

console:
  enabled: true
  ingress:
    enabled: true
    className: {{ .Values.ingressClass }}
    annotations:
      cert-manager.io/cluster-issuer: {{ .Values.clusterIssuer }}
      # La console Community n'a pas d'authentification (fonction Enterprise) :
      # authentification basique au niveau de l'Ingress (secret redpanda-console-auth).
      nginx.ingress.kubernetes.io/auth-type: basic
      nginx.ingress.kubernetes.io/auth-secret: redpanda-console-auth
      nginx.ingress.kubernetes.io/auth-realm: "Redpanda Console"
    hosts:
      - host: redpanda.{{ .Values.domain }}
        paths:
          - path: /
            pathType: Prefix
    tls:
      - secretName: redpanda-console-tls
        hosts:
          - redpanda.{{ .Values.domain }}
  resources:
    requests:
      cpu: 50m
      memory: 64Mi
    limits:
      memory: 256Mi
