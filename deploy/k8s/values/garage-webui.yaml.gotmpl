# garage-webui : interface web de Garage — https://garage.{{ .Values.domain }}
# Buckets, clés, navigateur de fichiers, état du cluster.
# Connexion : admin / mot de passe du secret garage-webui-auth (make ui-credentials).
# Déployé avec le chart générique bjw-s/app-template (pas de chart officiel).

controllers:
  main:
    containers:
      main:
        image:
          repository: khairul169/garage-webui
          tag: "1.1.0"
        env:
          API_BASE_URL: http://garage-admin.garage.svc:3903
          S3_ENDPOINT_URL: http://garage.garage.svc:3900
          S3_REGION: garage
          API_ADMIN_KEY:
            valueFrom:
              secretKeyRef:
                name: garage-admin-token
                key: token
          AUTH_USER_PASS:
            valueFrom:
              secretKeyRef:
                name: garage-webui-auth
                key: AUTH_USER_PASS
        probes:
          liveness:
            enabled: true
            type: TCP
          readiness:
            enabled: true
            type: TCP
        resources:
          requests:
            cpu: 10m
            memory: 32Mi
          limits:
            memory: 128Mi

service:
  main:
    controller: main
    ports:
      http:
        port: 3909

ingress:
  main:
    className: {{ .Values.ingressClass }}
    annotations:
      cert-manager.io/cluster-issuer: {{ .Values.clusterIssuer }}
      # Upload de fichiers via le navigateur de buckets.
      nginx.ingress.kubernetes.io/proxy-body-size: "0"
    hosts:
      - host: garage.{{ .Values.domain }}
        paths:
          - path: /
            pathType: Prefix
            service:
              identifier: main
              port: http
    tls:
      - secretName: garage-webui-tls
        hosts:
          - garage.{{ .Values.domain }}
