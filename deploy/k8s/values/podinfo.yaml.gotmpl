# podinfo : appli de démo, valide la chaîne Ingress + DNS + TLS.
# https://podinfo.{{ .Values.domain }}

replicaCount: 2

ui:
  message: "Cluster minikube {{ .Values.kubeContext }} — déployé par helmfile"

resources:
  requests:
    cpu: 10m
    memory: 32Mi
  limits:
    memory: 128Mi

# Répartit les réplicas sur des nœuds différents quand c'est possible.
topologySpreadConstraints:
  - maxSkew: 1
    topologyKey: kubernetes.io/hostname
    whenUnsatisfiable: ScheduleAnyway
    labelSelector:
      matchLabels:
        app.kubernetes.io/name: podinfo

ingress:
  enabled: true
  className: {{ .Values.ingressClass }}
  annotations:
    cert-manager.io/cluster-issuer: {{ .Values.clusterIssuer }}
  hosts:
    - host: podinfo.{{ .Values.domain }}
      paths:
        - path: /
          pathType: Prefix
  tls:
    - secretName: podinfo-tls
      hosts:
        - podinfo.{{ .Values.domain }}
